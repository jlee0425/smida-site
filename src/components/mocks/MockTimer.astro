---
import PhoneFrame from './PhoneFrame.astro';
import { getLocale, useT } from '../../i18n/utils';
const { look } = useT(getLocale(Astro.currentLocale));
---
<PhoneFrame caption={look.timer}>
  <div class="ph-row"><span class="ph-sub">Fran · For time</span><span class="chip on">FOR TIME</span></div>
  <div class="score mt-7 mb-1 text-center text-[68px]">12:04</div>
  <div class="ph-sub text-center !text-brand-300">WORK · ROUND 3 / 8</div>
  <div class="progress"><i></i></div>
  <div class="ph-card mt-3.5"><div class="ph-sub">Next</div><b>Rest 1:00</b></div>
  <div class="ghost"><span>Round +1</span><span>Pause</span></div>
</PhoneFrame>

<style>
  .progress { margin-top: 18px; height: 8px; border-radius: 99px; background: var(--color-border-subtle); overflow: hidden; }
  .progress i { display: block; height: 100%; width: 37%; background: var(--gradient-for-time); }
  .ghost { margin-top: auto; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .ghost span { background: var(--color-surface-card); border: 1px solid var(--color-border-default); border-radius: 12px; padding: 10px; text-align: center; color: var(--color-text-secondary); font-weight: 700; }
</style>
