---
import { androidBeta, testflight } from '../i18n/ui';
import TestflightQr from './TestflightQr.astro';
import { getLocale, useT } from '../i18n/utils';
const { cta } = useT(getLocale(Astro.currentLocale));
---
<div class="flex flex-wrap items-center gap-3">
  <a class="btn btn-primary" href="https://instagram.com/smida_fit" rel="noopener">{cta.follow}</a>
  <a class="btn btn-secondary" href={testflight} rel="noopener">{cta.beta}</a>
  <a class="inline-flex min-h-10 items-center text-[14px] text-text-secondary hover:text-text-primary" href={androidBeta}>{cta.android}</a>
</div>
<TestflightQr />
