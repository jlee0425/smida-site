---
import { getLocale, pathFor, useT } from '../i18n/utils';
const locale = getLocale(Astro.currentLocale);
const t = useT(locale);
---
<footer class="mt-6 border-t border-border-subtle pt-6 pb-10 text-sm text-text-muted">
  <nav class="mb-2 flex flex-wrap gap-x-5 gap-y-2" aria-label={t.a11y.footer}>
    {(['features', 'about', 'support'] as const).map((p) => <a class="text-text-secondary underline" href={pathFor(locale, p)}>{t.nav[p]}</a>)}
    <a class="text-text-secondary underline" href="https://instagram.com/smida_fit" rel="noopener">Instagram</a>
  </nav>
  <p>© 2026 Smida</p>
</footer>
