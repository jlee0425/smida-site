---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocale, localeStaticPaths, useT } from '../../i18n/utils';

export function getStaticPaths() {
  return localeStaticPaths();
}
const { support } = useT(getLocale(Astro.currentLocale));
---
<BaseLayout page="support">
  <div class="max-w-[720px] pt-4 pb-12">
    <h1 class="page-h">{support.heading}</h1>
    {
      support.faq.map((f, i) => (
        <details open={i === 0} class="my-2.5 rounded-[14px] bg-surface-card px-4 py-3.5">
          <summary class="cursor-pointer font-bold">{f.q}</summary>
          <p class="mt-2" set:html={f.a} />
        </details>
      ))
    }
    <h2 class="mt-8">{support.contact}</h2>
    <p><a href="mailto:hello@smida.fit">hello@smida.fit</a></p>
  </div>
</BaseLayout>
